# ===== DeepSeek API(对话)=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
UNIFIED_LLM=true
VISION_IMAGE_DETAIL=low

# ===== 虚拟形象后端(vts/null)=====
AVATAR_BACKEND=vts
AVATAR_SKIN=

# ===== B站直播间 =====
BILIBILI_ROOM_ID=

# ===== CosyVoice 3.5(阿里云百炼 TTS)=====
DASHSCOPE_API_KEY=
COSYVOICE_VOICE_ID=
COSYVOICE_MODEL=cosyvoice-v3.5-flash

# ===== 豆包端到端实时语音(可选)=====
SPEECH_LLM_API_KEY=

# ===== VTS 闲置动画 hotkey ID(可选,在 VTS 里配置后填入)=====
VTS_IDLE_EAT_ID=
VTS_IDLE_SLEEP_ID=
VTS_IDLE_EAT_INTERVAL=15
VTS_IDLE_SLEEP_AFTER=60
